  "web_port": 5173,
  "frontend_prepare": [
    [
      "{npm}",
      "run",
      "predev"
    ]
  ],
  "frontend_command": [
    "node",
    "node_modules/vite/bin/vite.js",
    "--host",
    "127.0.0.1",
    "--port",
    "{web_port}",
    "--strictPort"
  ],
  "generation": [
    {
      "script": "scripts/local/producer_bridge.py",
      "args": [
        "generate",
        "{stage}"
      ]
    }
  ],
  "validators": [
