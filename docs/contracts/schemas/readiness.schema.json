{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChronoScope document readiness",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "product_version", "catalog_sha256", "contracts"],
  "properties": {
    "schema": {"const": "chronoscope.readiness/v1"},
    "product_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "status", "state", "missing"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
          "status": {"enum": ["real", "active"]},
          "state": {"enum": ["available", "missing"]},
          "missing": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "if": {"properties": {"state": {"const": "available"}}},
        "then": {"properties": {"missing": {"maxItems": 0}}},
        "else": {"properties": {"missing": {"minItems": 1}}}
      }
    }
  }
}
