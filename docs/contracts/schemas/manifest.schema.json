{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "manifest",
  "type": "object",
  "required": [
    "schema",
    "case_id",
    "category",
    "real_or_synthetic",
    "expected_band",
    "engine",
    "provenance",
    "analysis_artifact",
    "streaming_artifact",
    "series",
    "seed",
    "artifact",
    "lane",
    "gate",
    "flags",
    "best_method",
    "metrics"
  ],
  "properties": {
    "schema": {
      "const": "chronoscope.manifest/v1"
    },
    "case_id": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "real_or_synthetic": {
      "type": "string"
    },
    "expected_band": {
      "type": "string"
    },
    "engine": {
      "type": "object",
      "required": [
        "package",
        "version",
        "model"
      ],
      "properties": {
        "package": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": [
        "source",
        "license",
        "citation",
        "public_artifact_ok"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "citation": {
          "type": "string"
        },
        "public_artifact_ok": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "analysis_artifact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "format",
            "analysis_schema",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "analysis_schema": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "streaming_artifact": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "path",
            "format",
            "streaming_schema",
            "bytes"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "format": {
              "type": "string"
            },
            "streaming_schema": {
              "type": "string"
            },
            "bytes": {
              "type": "integer",
              "minimum": 0
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "series": {
      "$ref": "#/$defs/SeriesDescriptors"
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "artifact": {
      "$ref": "#/$defs/ArtifactRef"
    },
    "lane": {
      "enum": [
        "live",
        "precompute"
      ]
    },
    "gate": {
      "$ref": "#/$defs/GateVerdict"
    },
    "flags": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": {
          "type": "string"
        }
      }
    },
    "best_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "number",
          "null"
        ]
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "SeriesDescriptors": {
      "type": "object",
      "required": [
        "n_obs",
        "seasonality",
        "horizon",
        "source",
        "mean",
        "std",
        "trend_slope",
        "seasonal_strength",
        "acf1",
        "pct_zeros"
      ],
      "properties": {
        "n_obs": {
          "type": "integer",
          "minimum": 1
        },
        "seasonality": {
          "type": "integer",
          "minimum": 1
        },
        "horizon": {
          "type": "integer",
          "minimum": 1
        },
        "source": {
          "type": "string"
        },
        "mean": {
          "type": "number"
        },
        "std": {
          "type": "number"
        },
        "trend_slope": {
          "type": "number"
        },
        "seasonal_strength": {
          "type": "number"
        },
        "acf1": {
          "type": "number"
        },
        "pct_zeros": {
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "ArtifactRef": {
      "type": "object",
      "required": [
        "path",
        "format",
        "trace_schema",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "trace_schema": {
          "type": "string"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "GateVerdict": {
      "type": "object",
      "required": [
        "lane",
        "pure_python",
        "wheels",
        "trace_bytes",
        "run_ms_budget",
        "trace_bytes_budget",
        "reasons"
      ],
      "properties": {
        "lane": {
          "type": "string"
        },
        "pure_python": {
          "type": "boolean"
        },
        "wheels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "trace_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "run_ms_budget": {
          "type": "number"
        },
        "trace_bytes_budget": {
          "type": "integer",
          "minimum": 0
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
